# Dreamer lanes. Run from the Dreamer/ folder:
#   bundle exec fastlane sim                                  # build, boot iPhone 17, install, launch
#   bundle exec fastlane sim device:"iPhone 17 Pro" screen:journal reset:true
#   bundle exec fastlane sim configuration:Staging            # Debug (default), Staging or Release
#   bundle exec fastlane test
#   bundle exec fastlane ui_test iterations:10                # UI tests, repeated until a failure
#   bundle exec fastlane build_release                        # unsigned Release build (CI)
#   bundle exec fastlane certificates                         # match: fetch signing assets
#   bundle exec fastlane signed_build configuration:Staging   # signed .ipa with match profiles
#   bundle exec fastlane upload_dsyms                         # dSYMs of the last archive to Sentry
#   bundle exec fastlane beta configuration:Staging           # signed build to internal TestFlight
#   bundle exec fastlane release                              # App Store build + metadata, no submission
#   bundle exec fastlane screenshots                          # App Store screenshots (6.9" and 6.5")
#   bundle exec fastlane upload_store                         # metadata + screenshots to App Store Connect

default_platform(:ios)

PROJECT = "Dreamer.xcodeproj"
SCHEME = "Dreamer"
# Debug and Staging share the staging bundle id; Release is the App Store id.
BUNDLE_IDS = {
  "Debug" => "com.braincode.dreamer.io.staging",
  "Staging" => "com.braincode.dreamer.io.staging",
  "Release" => "com.braincode.dreamer.io"
}.freeze
DEFAULT_DEVICE = ENV.fetch("SIMULATOR_DEVICE", "iPhone 17")
DERIVED_DATA = File.expand_path("../build/DerivedData", __dir__)
# The OpenAPI generator is a build plugin; command-line builds cannot answer Xcode's trust prompt.
PLUGIN_XCARGS = "-skipPackagePluginValidation"

platform :ios do
  desc "Build the app and run it in the simulator"
  desc "Options: device (simulator name), screen (debug start screen, e.g. journal), reset (true = clean install),"
  desc "configuration (Debug, Staging or Release)"
  lane :sim do |options|
    configuration = options[:configuration] || "Debug"
    bundle_id = BUNDLE_IDS.fetch(configuration) { UI.user_error!("Unknown configuration '#{configuration}'") }
    udid = boot_simulator(name: options[:device] || DEFAULT_DEVICE)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: configuration,
      destination: "platform=iOS Simulator,id=#{udid}",
      derived_data_path: DERIVED_DATA,
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      xcargs: PLUGIN_XCARGS
    )

    app_path = File.join(DERIVED_DATA, "Build/Products/#{configuration}-iphonesimulator/#{SCHEME}.app")
    # A clean install also drops the cached launch screen and saved preferences.
    sh("xcrun simctl uninstall #{udid} #{bundle_id}") if options[:reset]
    sh("xcrun simctl install #{udid} #{app_path.shellescape}")

    launch_arguments = options[:screen] ? "-debugScreen #{options[:screen]}" : ""
    sh("xcrun simctl launch --terminate-running-process #{udid} #{bundle_id} #{launch_arguments}")
  end

  desc "App Store screenshots: each screen of fastlane/screenshots.json opened with -debugScreen on"
  desc "mock data, with a clean status bar, then captioned by scripts/frame_screenshots.py"
  lane :screenshots do
    config = JSON.parse(File.read(File.expand_path("screenshots.json", __dir__)))
    udid = boot_simulator(name: config["device"])
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: "platform=iOS Simulator,id=#{udid}",
      derived_data_path: DERIVED_DATA,
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      xcargs: PLUGIN_XCARGS
    )
    bundle_id = BUNDLE_IDS.fetch("Debug")
    app_path = File.join(DERIVED_DATA, "Build/Products/Debug-iphonesimulator/#{SCHEME}.app")
    sh("xcrun simctl uninstall #{udid} #{bundle_id}")
    sh("xcrun simctl install #{udid} #{app_path.shellescape}")
    sh("xcrun simctl status_bar #{udid} override --time 9:41 --batteryState charged --batteryLevel 100 " \
       "--cellularMode active --cellularBars 4 --wifiBars 3 --dataNetwork wifi")

    raw_dir = File.expand_path("screenshots/raw", __dir__)
    FileUtils.mkdir_p(raw_dir)
    begin
      # The first launch of a fresh install shows system banners; let them pass before shooting.
      sh("xcrun simctl launch --terminate-running-process #{udid} #{bundle_id} -debugScreen home")
      sleep(10)
      config["shots"].each do |shot|
        arguments = (config["arguments"] + ["-debugScreen", shot["screen"]]).join(" ")
        sh("xcrun simctl launch --terminate-running-process #{udid} #{bundle_id} #{arguments}")
        sleep(shot["wait"])
        sh("xcrun simctl io #{udid} screenshot #{File.join(raw_dir, "#{shot['name']}.png").shellescape}")
      end
      # Unframed screens for App Store Connect review fields (the paywall for subscription review).
      review_dir = File.expand_path("review", __dir__)
      FileUtils.mkdir_p(review_dir)
      (config["review_shots"] || []).each do |shot|
        sh("xcrun simctl launch --terminate-running-process #{udid} #{bundle_id} " \
           "#{(config['arguments'] + ['-debugScreen', shot['screen']]).join(' ')}")
        sleep(shot["wait"])
        sh("xcrun simctl io #{udid} screenshot #{File.join(review_dir, "#{shot['name']}.png").shellescape}")
      end
    ensure
      sh("xcrun simctl status_bar #{udid} clear")
    end
    sh("python3 #{File.expand_path('../scripts/frame_screenshots.py', __dir__).shellescape}")
  end

  desc "A short screen recording of the review scenario (Home -> Record -> Details -> Analysis ->"
  desc "Interpretation) on mock data, for the App Review notes: fastlane/review/demo.mp4"
  lane :review_video do
    config = JSON.parse(File.read(File.expand_path("screenshots.json", __dir__)))
    udid = boot_simulator(name: config["device"])
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: "platform=iOS Simulator,id=#{udid}",
      derived_data_path: DERIVED_DATA,
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      xcargs: PLUGIN_XCARGS
    )
    bundle_id = BUNDLE_IDS.fetch("Debug")
    sh("xcrun simctl install #{udid} #{File.join(DERIVED_DATA, "Build/Products/Debug-iphonesimulator/#{SCHEME}.app").shellescape}")
    output = File.expand_path("review/demo.mp4", __dir__)
    FileUtils.mkdir_p(File.dirname(output))
    FileUtils.rm_f(output)
    base = config["arguments"].join(" ")
    recorder = Process.spawn("xcrun", "simctl", "io", udid, "recordVideo", "--codec=h264", "--force", output)
    begin
      sleep(1)
      [["home", 3], ["record", 7], ["details", 3], ["analysis", 7], ["interpretation", 6]].each do |screen, seconds|
        sh("xcrun simctl launch --terminate-running-process #{udid} #{bundle_id} #{base} -debugScreen #{screen}")
        sleep(seconds)
      end
    ensure
      Process.kill("INT", recorder)
      Process.wait(recorder)
    end
    UI.success("Review video: #{output}")
  end

  desc "Upload the metadata (fastlane/metadata) and screenshots to App Store Connect, no binary"
  desc "Needs the App Store Connect API key (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT)"
  lane :upload_store do
    screenshots = File.expand_path("screenshots", __dir__)
    has_screenshots = !Dir[File.join(screenshots, "en-US", "*.png")].empty?
    deliver(
      api_key: asc_api_key,
      app_identifier: BUNDLE_IDS.fetch("Release"),
      skip_binary_upload: true,
      skip_screenshots: !has_screenshots,
      overwrite_screenshots: has_screenshots,
      screenshots_path: screenshots,
      metadata_path: File.expand_path("metadata", __dir__),
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "UI tests of the critical scenarios (mock services), 'Dreamer UITests' scheme"
  desc "Options: device (simulator name), iterations (repeat until the first failure, e.g. 10)"
  lane :ui_test do |options|
    udid = boot_simulator(name: options[:device] || DEFAULT_DEVICE)
    iterations = (options[:iterations] || 1).to_i
    extra = iterations > 1 ? "-test-iterations #{iterations} -run-tests-until-failure" : ""
    run_tests(
      project: PROJECT,
      scheme: "Dreamer UITests",
      destination: "platform=iOS Simulator,id=#{udid}",
      derived_data_path: DERIVED_DATA,
      output_directory: File.expand_path("../build/test_output/ui", __dir__),
      result_bundle: true,
      xcargs: "#{PLUGIN_XCARGS} #{extra}"
    )
  end

  desc "Run the unit tests in the simulator"
  desc "Options: device (simulator name)"
  lane :test do |options|
    udid = boot_simulator(name: options[:device] || DEFAULT_DEVICE)

    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      destination: "platform=iOS Simulator,id=#{udid}",
      derived_data_path: DERIVED_DATA,
      output_directory: File.expand_path("../build/test_output", __dir__),
      output_types: "junit,html",
      result_bundle: true,
      xcargs: PLUGIN_XCARGS,
    )
  end

  desc "Compile the Release configuration for devices without signing (CI check that the App Store build builds)"
  lane :build_release do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      derived_data_path: DERIVED_DATA,
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      xcargs: "CODE_SIGNING_ALLOWED=NO #{PLUGIN_XCARGS}"
    )
  end

  desc "Download (or, with readonly:false, create) certificates and profiles with match"
  desc "Needs MATCH_GIT_URL, MATCH_PASSWORD, APPLE_TEAM_ID and the App Store Connect API key variables"
  lane :certificates do |options|
    readonly = options.fetch(:readonly, true)
    api_key = asc_api_key
    match(type: "development", readonly: readonly, api_key: api_key)
    match(type: "appstore", readonly: readonly, api_key: api_key)
  end

  desc "Archive a signed build with match profiles: configuration Staging (default) or Release"
  lane :signed_build do |options|
    configuration = options[:configuration] || "Staging"
    bundle_id = BUNDLE_IDS.fetch(configuration)
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, app_identifier: bundle_id, api_key: asc_api_key)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      targets: [SCHEME],
      build_configurations: [configuration],
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][bundle_id]
    )
    build_app(
      project: PROJECT,
      scheme: configuration == "Staging" ? "Dreamer Staging" : SCHEME,
      configuration: configuration,
      derived_data_path: DERIVED_DATA,
      output_directory: File.expand_path("../build/archive", __dir__),
      export_method: "app-store",
      xcargs: [PLUGIN_XCARGS, options[:build_number] && "CURRENT_PROJECT_VERSION=#{options[:build_number]}"].compact.join(" ")
    )
    upload_dsyms if ENV["SENTRY_AUTH_TOKEN"]
  end

  desc "A signed build to TestFlight. The build number is TestFlight's latest + 1"
  desc "Options: configuration (Staging, default, or Release); external:true also sends it to the external"
  desc "group 'Beta' for Apple's beta review - only after Tony's explicit yes"
  lane :beta do |options|
    configuration = options[:configuration] || "Staging"
    bundle_id = BUNDLE_IDS.fetch(configuration)
    external = options[:external].to_s == "true"
    api_key = asc_api_key
    build_number = latest_testflight_build_number(app_identifier: bundle_id, api_key: api_key, initial_build_number: 0) + 1
    signed_build(configuration: configuration, build_number: build_number)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: latest_ipa,
      changelog: tester_notes,
      skip_waiting_for_build_processing: !external,
      distribute_external: external,
      groups: external ? ["Beta"] : nil,
      notify_external_testers: external
    )
    UI.success("#{configuration} build #{build_number} uploaded for #{external ? 'external and internal' : 'internal'} testers")
  end

  desc "The App Store version: a signed Release build (build number = TestFlight's latest + 1), uploaded"
  desc "with the metadata and screenshots of fastlane/. Never submits unless submit:true - Tony's yes first"
  lane :release do |options|
    bundle_id = BUNDLE_IDS.fetch("Release")
    api_key = asc_api_key
    build_number = latest_testflight_build_number(app_identifier: bundle_id, api_key: api_key, initial_build_number: 0) + 1
    signed_build(configuration: "Release", build_number: build_number)
    # Screenshots are generated, not committed: without a local set (CI) the ones already in App
    # Store Connect stay - overwriting with an empty folder would delete them.
    screenshots = File.expand_path("screenshots", __dir__)
    has_screenshots = !Dir[File.join(screenshots, "en-US", "*.png")].empty?
    deliver(
      api_key: api_key,
      app_identifier: bundle_id,
      ipa: latest_ipa,
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: screenshots,
      skip_screenshots: !has_screenshots,
      overwrite_screenshots: has_screenshots,
      submit_for_review: options[:submit].to_s == "true",
      automatic_release: false,
      phased_release: true,
      submission_information: { add_id_info_uses_idfa: false },
      force: true,
      precheck_include_in_app_purchases: false
    )
    UI.success("Release build #{build_number} uploaded#{options[:submit].to_s == 'true' ? ' and submitted for review' : ''}")
  end

  # The newest .ipa of build/archive.
  private_lane :latest_ipa do
    Dir[File.expand_path("../build/archive/*.ipa", __dir__)].max_by { |file| File.mtime(file) }
  end

  # "What to test" for TestFlight: the release notes of the version, then the commits since the last tag.
  private_lane :tester_notes do
    notes = File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)).strip
    last_tag = sh("git describe --tags --abbrev=0 2>/dev/null || true", log: false).strip
    range = last_tag.empty? ? "-20" : "#{last_tag}..HEAD"
    commits = sh("git log #{range} --no-merges --pretty=format:'- %s'", log: false).strip
    [notes, commits.empty? ? nil : "Changes:\n#{commits}"].compact.join("\n\n")[0, 4000]
  end

  desc "Upload the dSYMs of the last build to Sentry (SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT; needs sentry-cli)"
  lane :upload_dsyms do
    sentry_debug_files_upload(
      auth_token: ENV.fetch("SENTRY_AUTH_TOKEN"),
      org_slug: ENV.fetch("SENTRY_ORG"),
      project_slug: ENV.fetch("SENTRY_PROJECT"),
      path: File.expand_path("../build/archive", __dir__)
    )
  end

  # App Store Connect API key from the environment (no Apple ID password, works in CI).
  # ASC_KEY_CONTENT is the base64 of the .p8 file.
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  # Finds an available simulator by name (a booted one first, then the newest runtime),
  # boots it and brings the Simulator app to the front. Returns its UDID.
  private_lane :boot_simulator do |options|
    name = options[:name]
    devices = JSON.parse(sh("xcrun simctl list devices available -j", log: false))["devices"]
    candidates = devices.flat_map do |runtime, list|
      version = runtime[/iOS-(\d+)-(\d+)/] ? Gem::Version.new("#{$1}.#{$2}") : Gem::Version.new("0")
      list.select { |device| device["name"] == name }.map { |device| device.merge("version" => version) }
    end
    if candidates.empty?
      # CI images ship different simulators; fall back to the newest available iPhone.
      candidates = devices.flat_map do |runtime, list|
        version = runtime[/iOS-(\d+)-(\d+)/] ? Gem::Version.new("#{$1}.#{$2}") : Gem::Version.new("0")
        list.select { |device| device["name"].start_with?("iPhone") }.map { |device| device.merge("version" => version) }
      end
      UI.user_error!("No available iPhone simulator. See `xcrun simctl list devices available`.") if candidates.empty?
      UI.important("No simulator named '#{name}', using the newest available iPhone")
    end

    device = candidates.max_by { |d| [d["state"] == "Booted" ? 1 : 0, d["version"]] }
    udid = device["udid"]
    UI.message("Simulator: #{device['name']} (iOS #{device['version']}) #{udid}")

    sh("xcrun simctl boot #{udid}") unless device["state"] == "Booted"
    sh("xcrun simctl bootstatus #{udid}", log: false)
    sh("open -a Simulator --args -CurrentDeviceUDID #{udid}")
    udid
  end
end
