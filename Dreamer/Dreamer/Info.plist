<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>DreamerEnvironment</key>
	<string>$(APP_ENVIRONMENT)</string>
	<key>DreamerAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>DreamerRevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>DreamerPostHogAPIKey</key>
	<string>$(POSTHOG_API_KEY)</string>
	<key>DreamerPostHogHost</key>
	<string>$(POSTHOG_HOST)</string>
	<key>DreamerSentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>DreamerAPSEnvironment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>DreamerFacebookAppID</key>
	<string>$(FACEBOOK_APP_ID)</string>
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSFaceIDUsageDescription</key>
	<string>Dreamer uses Face ID to keep your dream journal private.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Dreamer uses this to see which ads bring people to the app. Your dreams are never shared.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>CormorantGaramond-Regular.ttf</string>
		<string>CormorantGaramond-Medium.ttf</string>
		<string>CormorantGaramond-SemiBold.ttf</string>
		<string>CormorantGaramond-Bold.ttf</string>
		<string>CormorantGaramond-MediumItalic.ttf</string>
		<string>CormorantGaramond-SemiBoldItalic.ttf</string>
	</array>
</dict>
</plist>
