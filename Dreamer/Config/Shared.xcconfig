// Settings shared by every configuration.
// SDK keys are never committed: they come from Secrets.xcconfig (local, git-ignored) or from CI
// secrets. An empty key means the SDK stays off and the app uses its local fallback.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Every environment is https on API_HOST. "//" starts a comment in xcconfig, hence the $().
API_BASE_URL = https:/$()/$(API_HOST)

REVENUECAT_API_KEY =
POSTHOG_API_KEY =
POSTHOG_HOST =
SENTRY_DSN =
// Meta app id for sharing to Instagram Stories (not a secret; value from Tony, blocker IOS-05.6).
// Empty: the Stories button is hidden and sharing goes through the share sheet only.
FACEBOOK_APP_ID =
// Google Sign-In (GoogleSignIn-iOS): the iOS OAuth client of com.braincode.dreamer.io and its
// reversed form, the URL scheme Google returns through. Not secrets: both ship in every app.
// Every configuration is that bundle id. Empty: the Google button is hidden in live builds; mock
// mode always shows it.
GOOGLE_IOS_CLIENT_ID = 240861363646-iv2i51rs4dp2gc6fhvl332405f5668i9.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.240861363646-iv2i51rs4dp2gc6fhvl332405f5668i9
