// App Store build.
#include "Shared.xcconfig"

APP_ENVIRONMENT = production
// The production API domain is not chosen yet (blocker in PROGRESS.md). Empty = the app
// has no API instead of silently hitting staging; set API_HOST[config=Release] in Secrets.xcconfig.
API_HOST =
APS_ENVIRONMENT = production
APP_ATTEST_ENVIRONMENT = production
PRODUCT_BUNDLE_IDENTIFIER = com.braincode.dreamer
DREAMER_DISPLAY_NAME = Dreamer
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

#include? "Secrets.xcconfig"
