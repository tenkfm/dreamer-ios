// Optimized build against the staging backend (internal TestFlight).
#include "Shared.xcconfig"

APP_ENVIRONMENT = staging
API_HOST = staging-api.dreamerapp.io
// Staging is archived for TestFlight, which uses the production APNs and App Attest environments.
APS_ENVIRONMENT = production
APP_ATTEST_ENVIRONMENT = production
PRODUCT_BUNDLE_IDENTIFIER = com.braincode.dreamer.io.staging
DREAMER_DISPLAY_NAME = Dreamer β
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Staging
SWIFT_ACTIVE_COMPILATION_CONDITIONS = STAGING $(inherited)

#include? "Secrets.xcconfig"
