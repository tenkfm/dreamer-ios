// Copy to Secrets.xcconfig (git-ignored) and fill in. CI writes the same file from its secrets.
// Values may differ per configuration with the [config=...] condition, for example:
//   REVENUECAT_API_KEY[config=Release] = appl_xxx
//   REVENUECAT_API_KEY = appl_sandbox_xxx
// Never print these values in logs or CI output - only their names.

REVENUECAT_API_KEY =
POSTHOG_API_KEY =
POSTHOG_HOST =
SENTRY_DSN =
// Analytics and attribution run only in production builds, hence [config=Release]:
// POSTHOG_API_KEY[config=Release] = phc_xxx
// POSTHOG_HOST[config=Release] = https:/$()/eu.i.posthog.com
// APPSFLYER_DEV_KEY[config=Release] = xxx
APPSFLYER_DEV_KEY =
// Release uses api.dreamerapp.io (Release.xcconfig); override only to point it elsewhere:
// API_HOST[config=Release] = api.<domain>
